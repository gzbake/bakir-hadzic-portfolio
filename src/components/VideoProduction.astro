---
import { videoProduction } from '../data/portfolio';
---

<section class="video section-padding" id="video">
  <div class="container">
    <div class="video__header">
      <p class="mono-label">05 / PRODUCTION</p>
      <h2 class="video__title">{videoProduction.title}</h2>
      <p class="video__desc">{videoProduction.description}</p>
    </div>

    <div class="video__categories">
      {videoProduction.categories.map((cat) => (
        <div class="video__cat">
          <h3 class="video__cat-title">{cat.title}</h3>
          <ul class="video__cat-list">
            {cat.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="video__projects">
      {videoProduction.projects.map((project) => (
        <div class="video__project">
          <div class="video__project-info">
            <h4 class="video__project-title">{project.title}</h4>
            <p class="video__project-cat">{project.category}</p>
          </div>
          <span class="video__project-availability mono-label">{project.availability}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .video__header {
    max-width: 640px;
    margin-bottom: var(--space-3xl);
  }

  .video__title {
    margin-block: var(--space-sm) var(--space-md);
  }

  .video__desc {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .video__categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xl);
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-3xl);
    border-bottom: 1px solid var(--border-subtle);
  }

  .video__cat-title {
    font-size: 1rem;
    margin-bottom: var(--space-md);
    color: var(--accent-cyan);
  }

  .video__cat-list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .video__cat-list li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .video__cat-list li::before {
    content: '— ';
    color: var(--text-muted);
  }

  .video__projects {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .video__project {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
    transition: background var(--transition-fast);
  }

  .video__project:first-child {
    border-top: 1px solid var(--border-subtle);
  }

  .video__project:hover {
    background: rgba(18, 215, 232, 0.02);
  }

  .video__project-title {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .video__project-cat {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .video__project-availability {
    font-size: 0.6875rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .video__categories {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .video__project {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

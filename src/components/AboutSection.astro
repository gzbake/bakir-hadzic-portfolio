---
import { about } from '../data/portfolio';
---

<section class="about section-padding" id="about">
  <div class="container">
    <div class="about__grid">
      <div class="about__main">
        <p class="mono-label">06 / ABOUT</p>
        <h2 class="about__headline">{about.headline}</h2>
        {about.copy.split('\n\n').map((paragraph) => (
          <p class="about__text">{paragraph}</p>
        ))}
      </div>

      <div class="about__differentiator">
        <h3 class="about__diff-title">How I work</h3>
        <div class="about__flow">
          {about.differentiators.map((item, index) => (
            <div class="about__flow-item">
              <div class="about__flow-step">
                <span class="about__flow-label">{item.label}</span>
                <p class="about__flow-desc">{item.description}</p>
              </div>
              {index < about.differentiators.length - 1 && (
                <span class="about__flow-arrow" aria-hidden="true">→</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="about__meta">
      <div class="about__meta-block">
        <h4 class="about__meta-title mono-label">Education</h4>
        {about.education.map((edu) => (
          <div class="about__meta-item">
            <p class="about__meta-primary">{edu.school}</p>
            <p class="about__meta-secondary">{edu.detail}</p>
          </div>
        ))}
      </div>
      <div class="about__meta-block">
        <h4 class="about__meta-title mono-label">Certifications</h4>
        {about.certifications.map((cert) => (
          <p class="about__meta-item about__meta-primary">{cert}</p>
        ))}
      </div>
      <div class="about__meta-block">
        <h4 class="about__meta-title mono-label">Languages</h4>
        {about.languages.map((lang) => (
          <div class="about__meta-item">
            <p class="about__meta-primary">{lang.language}</p>
            <p class="about__meta-secondary">{lang.level}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-3xl);
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-3xl);
    border-bottom: 1px solid var(--border-subtle);
  }

  .about__headline {
    margin-block: var(--space-md) var(--space-lg);
    max-width: 520px;
  }

  .about__text {
    font-size: 1.0625rem;
    line-height: 1.75;
    margin-bottom: var(--space-md);
    max-width: 560px;
  }

  .about__diff-title {
    font-size: 1rem;
    margin-bottom: var(--space-xl);
    color: var(--text-secondary);
  }

  .about__flow {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .about__flow-item {
    display: contents;
  }

  .about__flow-step {
    padding: var(--space-md) var(--space-lg);
    border-left: 2px solid var(--accent-cyan);
    background: var(--bg-surface);
  }

  .about__flow-label {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    margin-bottom: 0.25rem;
  }

  .about__flow-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .about__flow-arrow {
    color: var(--text-muted);
    font-size: 1.25rem;
    padding-left: var(--space-lg);
  }

  .about__meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xl);
  }

  .about__meta-title {
    margin-bottom: var(--space-md);
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .about__meta-item {
    margin-bottom: var(--space-md);
  }

  .about__meta-primary {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .about__meta-secondary {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-top: 0.125rem;
  }

  @media (max-width: 968px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__meta {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>

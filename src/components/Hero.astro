---
import { site } from '../data/site';
---

<section class="hero" id="top" data-section="hero">
  <div class="wrap hero__inner">
    <div class="hero__media" data-hero="media">
      <img src={site.portrait} alt={`${site.name} portrait`} data-hero-img />
    </div>

    <div class="hero__copy">
      <p class="section-kicker reveal" data-hero="eyebrow">{site.eyebrow}</p>
      <h1 class="hero__name reveal" data-hero="name">{site.name}</h1>
      <p class="hero__title reveal" data-hero="title">{site.title}</p>
      <p class="hero__intro reveal" data-hero="intro">{site.intro}</p>
      <p class="hero__meta reveal" data-hero="meta">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z" stroke-linejoin="round"></path>
          <circle cx="12" cy="10" r="2.2"></circle>
        </svg>
        <span>{site.location}</span>
      </p>
      <div class="hero__actions reveal" data-hero="scroll">
        <a href="#work" class="btn btn--light js-magnet">
          Scroll to see my work
          <span class="arrow">↓</span>
        </a>
        <a href="#contact" class="btn btn--ghost js-magnet">Contact Me</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--nav-h) + 4.5rem);
    padding-bottom: 3.5rem;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(260px, 440px) minmax(0, 1fr);
    gap: 4.75rem;
    align-items: start;
  }

  .hero__media {
    overflow: hidden;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 3 / 4;
    border-radius: 8px;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    will-change: transform;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    padding-top: 2.75rem;
    min-width: 0;
  }

  .hero__name {
    font-size: clamp(3.75rem, 6.5vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
    margin-bottom: 1.2rem;
  }

  .hero__title {
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    color: var(--text-muted);
    margin-bottom: 1.55rem;
  }

  .hero__intro {
    font-size: clamp(1.28rem, 1.95vw, 1.65rem);
    max-width: 22ch;
    line-height: 1.4;
    letter-spacing: -0.03em;
    margin-bottom: 1.45rem;
  }

  .hero__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-dim);
    margin-bottom: 2.25rem;
    width: fit-content;
  }

  .hero__meta svg {
    width: 15px;
    height: 15px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero__actions .arrow {
    transition: transform 0.35s var(--ease);
  }

  .hero__actions a:hover .arrow {
    transform: translateY(3px);
  }

  @media (max-width: 1100px) {
    .hero__inner {
      grid-template-columns: minmax(240px, 380px) minmax(0, 1fr);
      gap: 3.25rem;
    }

    .hero__media {
      max-width: 380px;
    }

    .hero__copy {
      padding-top: 1.75rem;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: calc(var(--nav-h) + 2rem);
      padding-bottom: 2.25rem;
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .hero__media {
      max-width: 260px;
      aspect-ratio: 3 / 4;
    }

    .hero__copy {
      padding-top: 0;
    }

    .hero__intro {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .hero__media {
      max-width: 220px;
    }

    .hero__actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

---
import { skillGroups } from '../data/skills';
---

<section class="section skills" id="skills" data-section="skills">
  <div class="wrap">
    <p class="section-kicker reveal" data-reveal="up">04 / SKILLS</p>
    <h2 class="section-title reveal" data-reveal="up">Skills & tools</h2>
    <div class="skills__grid">
      {skillGroups.map((group) => (
        <article class="skills__group reveal" data-stagger>
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    padding-top: 7.5rem;
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .skills__group {
    padding: 1.4rem 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.025);
  }

  .skills__group h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .skills__group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .skills__group li {
    padding: 0.38rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(17, 17, 17, 0.35);
    color: var(--text-muted);
    font-size: 0.8rem;
    letter-spacing: -0.02em;
  }

  @media (max-width: 1100px) {
    .skills__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .skills {
      padding-top: 7rem;
      padding-bottom: 0;
    }

    .skills__grid {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      padding: 0.9rem 0.85rem 0.95rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.03);
    }

    .skills__group {
      padding: 0;
      border: none;
      border-radius: 0;
      background: none;
    }

    .skills__group h3 {
      margin-bottom: 0.4rem;
      font-size: 0.62rem;
    }

    .skills__group ul {
      gap: 0.32rem;
    }

    .skills__group li {
      padding: 0.22rem 0.5rem;
      font-size: 0.72rem;
      animation: skill-in 0.55s var(--ease) both;
    }

    .skills__group:nth-child(1) li { animation-delay: 0.02s; }
    .skills__group:nth-child(2) li { animation-delay: 0.08s; }
    .skills__group:nth-child(3) li { animation-delay: 0.14s; }
    .skills__group:nth-child(4) li { animation-delay: 0.2s; }
    .skills__group:nth-child(5) li { animation-delay: 0.26s; }
  }

  @keyframes skill-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

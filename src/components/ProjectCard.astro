---
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const href = `/work/${project.slug}`;
---

<article class={`project-card ${featured ? 'project-card--featured' : ''}`}>
  <a href={href} class="project-card__link">
    <div class="project-card__visual">
      <div class="browser-frame">
        <div class="browser-frame__bar">
          <span class="browser-frame__dot"></span>
          <span class="browser-frame__dot"></span>
          <span class="browser-frame__dot"></span>
        </div>
        <div class="browser-frame__content">
          <img src={project.images[0]?.src} alt={project.images[0]?.alt ?? project.title} loading="lazy" width="800" height="500" />
        </div>
      </div>
    </div>
    <div class="project-card__info">
      <p class="project-card__category mono-label">{project.category}</p>
      <h3 class="project-card__title">{project.title}</h3>
      <p class="project-card__desc">{project.description}</p>
      <span class="link-arrow">
        View Case Study
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .project-card {
    position: relative;
  }

  .project-card__link {
    display: block;
    transition: opacity var(--transition-base);
  }

  .project-card__link:hover .project-card__title {
    color: var(--accent-cyan);
  }

  .project-card__visual {
    margin-bottom: var(--space-lg);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .project-card__category {
    margin-bottom: var(--space-sm);
    font-size: 0.6875rem;
  }

  .project-card__title {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    margin-bottom: var(--space-sm);
    transition: color var(--transition-fast);
  }

  .project-card__desc {
    font-size: 0.9375rem;
    margin-bottom: var(--space-lg);
    max-width: 560px;
    line-height: 1.65;
  }

  .project-card--featured .project-card__desc {
    max-width: 640px;
  }
</style>

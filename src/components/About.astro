---
import { about } from '../data/site';
---

<section class="section about" id="about" data-section="about">
  <div class="wrap about__grid">
    <div class="about__left">
      <p class="section-kicker reveal" data-reveal="up">01 / ABOUT</p>
      <h2 class="about__heading reveal" data-reveal="up">About Me</h2>
      <p class="about__lead reveal" data-reveal="up">{about.lead}</p>
    </div>

    <div class="about__copy">
      {about.paragraphs.map((p) => (
        <p class="reveal" data-reveal="up">{p}</p>
      ))}
      <div class="about__personal">
        {about.personal.map((p) => (
          <p class="reveal" data-reveal="up">{p}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: 150px;
    background: linear-gradient(180deg, transparent, rgba(17, 17, 17, 0.28) 16%, rgba(17, 17, 17, 0.22) 84%, transparent);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .about__left {
    position: sticky;
    top: 250px;
  }

  .about__heading {
    font-size: clamp(2.5rem, 4.6vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin-bottom: 1.5rem;
  }

  .about__lead {
    font-size: clamp(1.6rem, 2.4vw, 2.15rem);
    line-height: 1.25;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 680px;
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.72;
  }

  .about__personal {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .about {
      padding-top: 115px;
    }

    .about__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about__left {
      position: static;
    }

    .about__lead {
      max-width: none;
    }
  }

  @media (max-width: 600px) {
    .about {
      padding-top: 90px;
    }
  }

  @media (max-width: 700px) {
    .about {
      padding-top: 7rem;
      padding-bottom: 0;
    }

    .about__grid {
      gap: 0.85rem;
    }

    .about__heading {
      font-size: clamp(1.85rem, 8.4vw, 2.35rem);
      margin-bottom: 0.7rem;
    }

    .about__lead,
    .about__copy,
    .about__copy p,
    .about__personal p {
      font-size: 1rem;
      line-height: 1.6;
    }

    .about__copy {
      gap: 0.85rem;
    }

    .about__copy p:nth-child(n + 4),
    .about__personal {
      display: none;
    }
  }
</style>

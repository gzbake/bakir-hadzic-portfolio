---
import { contact } from '../data/portfolio';
---

<section class="contact section-padding" id="contact">
  <div class="container">
    <div class="contact__inner">
      <div class="contact__content">
        <p class="mono-label">07 / CONTACT</p>
        <h2 class="contact__headline">Have a role where content, creative and growth overlap? Let's talk.</h2>
        <p class="contact__desc">
          Available for opportunities across social media, content, e-commerce, creative operations and digital marketing.
        </p>
      </div>

      <div class="contact__actions">
        <a href={`mailto:${contact.email}`} class="btn btn--primary">Email Me</a>
        <a href={contact.linkedin} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>

      <div class="contact__details">
        <div class="contact__detail">
          <span class="contact__detail-label mono-label">Email</span>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </div>
        <div class="contact__detail">
          <span class="contact__detail-label mono-label">LinkedIn</span>
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/bakirhadzic</a>
        </div>
        <div class="contact__detail">
          <span class="contact__detail-label mono-label">Telegram</span>
          <a href={contact.telegram} target="_blank" rel="noopener noreferrer">@baccaratofm</a>
        </div>
        <div class="contact__detail">
          <span class="contact__detail-label mono-label">Phone / WhatsApp</span>
          <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
        </div>
        <div class="contact__detail">
          <span class="contact__detail-label mono-label">Location</span>
          <span>{contact.location}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
  }

  .contact__inner {
    max-width: 720px;
  }

  .contact__headline {
    margin-block: var(--space-md) var(--space-lg);
  }

  .contact__desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--space-2xl);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-3xl);
  }

  .contact__details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--border-subtle);
  }

  .contact__detail {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .contact__detail-label {
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .contact__detail a,
  .contact__detail span {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .contact__detail a:hover {
    color: var(--accent-cyan);
  }

  @media (max-width: 580px) {
    .contact__details {
      grid-template-columns: 1fr;
    }

    .contact__actions {
      flex-direction: column;
    }

    .contact__actions .btn {
      justify-content: center;
    }
  }
</style>

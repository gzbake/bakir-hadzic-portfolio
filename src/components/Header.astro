---
import { navLinks, contact, site } from '../data/site';

const navHash = (href: string) => (href.includes('#') ? `#${href.split('#')[1]}` : href);
---

<header class="nav" id="site-nav">
  <div class="nav__inner wrap">
    <a href="/#top" class="nav__logo" aria-label={site.name}>
      <span class="nav__logo-full">{site.name}</span>
      <span class="nav__logo-short">BH</span>
    </a>

    <nav class="nav__links" aria-label="Main">
      {navLinks.map((link) => (
        <a href={link.href} class="nav__link" data-nav-link={navHash(link.href)}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav__end">
      <a href={contact.cvPath} class="btn btn--light btn--nav nav__cv" download>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 3v12" stroke-linecap="round"></path>
          <path d="M7 11l5 5 5-5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M5 21h14" stroke-linecap="round"></path>
        </svg>
        CV
      </a>
      <button class="nav__toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <nav class="nav__mobile" id="mobile-nav">
    {navLinks.map((link, index) => (
      <a href={link.href} class="nav__mobile-link" style={`--i: ${index}`}>{link.label}</a>
    ))}
    <a href={contact.cvPath} class="nav__mobile-link nav__mobile-cv" download style={`--i: ${navLinks.length}`}>
      Download CV
    </a>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    min-height: var(--nav-h);
    height: auto;
    overflow: visible;
    background: linear-gradient(180deg, rgba(17, 17, 17, 0.42), rgba(17, 17, 17, 0));
    transition: background 0.4s var(--ease), backdrop-filter 0.4s var(--ease), border-color 0.4s var(--ease);
    border-bottom: none;
  }

  .nav.is-solid {
    background: rgba(17, 17, 17, 0.38);
    backdrop-filter: blur(22px) saturate(1.15);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .nav.is-open,
  .nav.is-open.is-solid {
    background: rgba(17, 17, 17, 0.59);
    backdrop-filter: blur(22px) saturate(1.15);
    border-bottom-color: transparent;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--nav-h);
  }

  .nav__logo {
    font-weight: 600;
    letter-spacing: -0.035em;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .nav__logo-short {
    display: none;
  }

  .nav__links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.7rem;
    margin-left: auto;
    min-width: 0;
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-shrink: 0;
    margin-left: 0.4rem;
  }

  .nav__link {
    position: relative;
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: color 0.3s var(--ease);
    white-space: nowrap;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--text);
  }

  .nav__link.is-active {
    color: var(--accent);
  }

  .nav__link.is-active::after,
  .nav__link:hover::after {
    transform: scaleX(1);
  }

  .nav__toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
  }

  .nav__toggle span {
    position: absolute;
    left: 12px;
    width: 20px;
    height: 1.5px;
    background: var(--text);
    border-radius: 99px;
    transform-origin: center;
    transition: transform 0.35s var(--ease), opacity 0.25s var(--ease), top 0.35s var(--ease), width 0.35s var(--ease);
  }

  .nav__toggle span:nth-child(1) { top: 15px; width: 14px; }
  .nav__toggle span:nth-child(2) { top: 21px; }
  .nav__toggle span:nth-child(3) { top: 27px; width: 17px; }

  .nav__toggle.is-open span:nth-child(1) {
    top: 21px;
    width: 20px;
    transform: rotate(45deg);
  }

  .nav__toggle.is-open span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .nav__toggle.is-open span:nth-child(3) {
    top: 21px;
    width: 20px;
    transform: rotate(-45deg);
  }

  .nav__mobile {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    padding: 0 1.5rem;
    background: transparent;
    transform: translateY(-6px);
    transition:
      max-height 0.45s var(--ease),
      opacity 0.35s var(--ease),
      transform 0.45s var(--ease),
      padding 0.45s var(--ease);
  }

  .nav__mobile.is-open {
    max-height: 420px;
    opacity: 1;
    pointer-events: auto;
    padding: 0.35rem 1.5rem 1.35rem;
    transform: translateY(0);
  }

  .nav__mobile-link {
    padding: 0.8rem 0;
    font-size: 1.15rem;
    color: var(--text-muted);
    opacity: 0;
    transform: translateX(-10px);
    transition:
      color 0.3s var(--ease),
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
    transition-delay: 0s;
  }

  .nav__mobile.is-open .nav__mobile-link {
    opacity: 1;
    transform: translateX(0);
    transition-delay: calc(0.06s * var(--i, 0) + 0.08s);
  }

  .nav__mobile-cv {
    color: var(--text);
  }

  @media (max-width: 1180px) {
    .nav__links { gap: 1.15rem; }
    .nav__link { font-size: 0.82rem; }
  }

  @media (max-width: 980px) {
    .nav__links { display: none; }
    .nav__toggle { display: block; }
    .nav__cv { display: none; }
    .nav__end { margin-left: auto; }
  }

  @media (min-width: 981px) {
    .nav__mobile,
    .nav__mobile.is-open {
      display: none !important;
    }
  }

  @media (max-width: 700px) {
    .nav.is-open,
    .nav.is-open.is-solid {
      backdrop-filter: blur(7px) saturate(1.15);
    }

    .nav__inner {
      width: 100%;
      max-width: none;
      padding-left: 24px;
      padding-right: 24px;
      box-sizing: border-box;
      justify-content: space-between;
    }

    .nav__logo {
      font-size: 1.15rem;
      letter-spacing: -0.04em;
    }

    .nav__logo-full {
      display: none;
    }

    .nav__logo-short {
      display: inline;
    }

    .nav__end {
      margin-left: auto;
      gap: 0.45rem;
    }

    .nav__toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -8px;
    }

    .nav__mobile,
    .nav__mobile.is-open {
      width: 100%;
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
      box-sizing: border-box;
      padding-left: 24px;
      padding-right: 24px;
    }

    .nav__mobile.is-open {
      padding-top: 0.2rem;
      padding-bottom: calc(1.1rem + env(safe-area-inset-bottom));
    }

    .nav__mobile-link {
      min-height: 48px;
      display: flex;
      align-items: center;
      font-size: 1.05rem;
      color: var(--text);
    }
  }
</style>

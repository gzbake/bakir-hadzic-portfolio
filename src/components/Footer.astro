---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p>Bakir Hadžić © {year}</p>
    <p>Živinice, Bosnia & Herzegovina</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding-block: 28px;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-dim);
    font-size: 0.8125rem;
  }

  @media (max-width: 520px) {
    .footer__inner {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>

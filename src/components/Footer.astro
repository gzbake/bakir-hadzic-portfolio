---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p>Bakir Hadžić © {year}</p>
    <p>Živinice, Bosnia & Herzegovina</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding: 0 0 2.75rem;
    background: transparent;
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-dim);
    font-size: 0.8125rem;
  }

  @media (max-width: 520px) {
    .footer__inner {
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  @media (max-width: 700px) {
    .footer {
      padding: 0 0 calc(1.75rem + env(safe-area-inset-bottom));
    }
  }
</style>

---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = 'Bakir Hadžić — Social Media Marketing & Digital Content Specialist',
  description = 'Social media marketing and digital content specialist based in Bosnia and Herzegovina. Available for remote roles across social media, content, e-commerce and digital marketing.',
  image = '/images/og-preview.png',
  canonical,
} = Astro.props;

const siteUrl = Astro.site?.href ?? 'https://bakirhadzic.com';
const canonicalUrl = canonical ? new URL(canonical, siteUrl).href : Astro.url.href;
const ogImage = new URL(image, siteUrl).href;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1024" />
<meta property="og:image:height" content="595" />
<meta property="og:image:alt" content="Bakir Hadžić — Social Media Marketing & Digital Content Specialist" />
<meta property="og:site_name" content="Bakir Hadžić" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Bakir Hadžić',
  jobTitle: 'Social Media Marketing & Digital Content Specialist',
  url: siteUrl,
  email: 'bake2905@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Živinice',
    addressCountry: 'BA',
  },
  sameAs: ['https://linkedin.com/in/bakirhadzic'],
})} />

---
import { testimonials, testimonialsAverage, starKind } from '../data/testimonials';

const starSlots = [0, 1, 2, 3, 4];
const starPath =
  'M12 2.4l2.47 5.96 6.53.55-4.97 4.28 1.5 6.31L12 16.7 6.47 19.5l1.5-6.31L3 8.91l6.53-.55L12 2.4z';

function formatRating(rating: number) {
  return rating.toFixed(1);
}
---

<section class="section testimonials" id="testimonials" data-section="testimonials">
  <div class="testimonials__pin" data-testimonial-pin>
    <div class="wrap">
    <div class="testimonials__intro reveal" data-reveal="up">
      <p class="section-kicker">03 / SOCIAL PROOF</p>
      <h2 class="section-title">Built on Trust</h2>
      <div class="testimonials__proof">
        <span class="stars" aria-label={`${formatRating(testimonialsAverage)} out of 5 stars`}>
          {starSlots.map((index) => (
            <span class={`star star--${starKind(testimonialsAverage, index)}`}>
              <svg class="star__empty" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d={starPath}></path>
              </svg>
              <span class="star__fill">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                  <path d={starPath}></path>
                </svg>
              </span>
            </span>
          ))}
        </span>
        <p><strong>{formatRating(testimonialsAverage)}</strong> average from people I’ve worked with</p>
      </div>
    </div>

    <div class="testimonials__slider reveal" data-reveal="up" data-testimonial-slider>
      <div class="testimonials__viewport" data-testimonial-viewport>
        <div class="testimonials__track" data-testimonial-track>
          {testimonials.map((item, index) => (
            <article
              class="testimonials__card"
              data-testimonial-slide
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <div class="testimonials__rating">
                <span class="stars" aria-label={`${formatRating(item.rating)} out of 5 stars`}>
                  {starSlots.map((slot) => (
                    <span class={`star star--${starKind(item.rating, slot)}`}>
                      <svg class="star__empty" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                        <path d={starPath}></path>
                      </svg>
                      <span class="star__fill">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                          <path d={starPath}></path>
                        </svg>
                      </span>
                    </span>
                  ))}
                </span>
                <span>{formatRating(item.rating)}</span>
              </div>
              <p class="testimonials__quote">{item.quote}</p>
              <div class="testimonials__person">
                <img src={item.image} alt="" />
                <div>
                  <p class="testimonials__name">{item.name}</p>
                  <p class="testimonials__role">{item.role}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding-block: 0;
  }

  .testimonials__pin {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-h) + 1.5rem);
    padding-bottom: 3.5rem;
  }

  .testimonials__intro {
    max-width: 720px;
    margin-bottom: 0.35rem;
  }

  .testimonials__proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: -2.25rem 0 2.75rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .testimonials__proof strong {
    color: var(--text);
    font-weight: 600;
  }

  .star {
    position: relative;
    display: inline-block;
    width: 14px;
    height: 14px;
  }

  .testimonials__proof .star {
    width: 16px;
    height: 16px;
  }

  .star__empty {
    color: rgba(244, 241, 234, 0.16);
  }

  .star__fill {
    position: absolute;
    inset: 0 auto 0 0;
    overflow: hidden;
    width: 0;
    color: var(--accent);
  }

  .star--full .star__fill {
    width: 100%;
  }

  .star--half .star__fill {
    width: 50%;
  }

  .star svg {
    display: block;
  }

  .testimonials__slider {
    position: relative;
  }

  .testimonials__viewport {
    overflow: hidden;
    perspective: 1400px;
    min-height: 380px;
    cursor: grab;
  }

  .testimonials__viewport:active {
    cursor: grabbing;
  }

  .testimonials__track {
    position: relative;
    height: 380px;
    transform-style: preserve-3d;
  }

  .testimonials__card {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    width: min(560px, 78%);
    min-height: 360px;
    padding: 1.7rem 1.55rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.02)),
      rgba(21, 21, 21, 0.92);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
    transform-origin: center center;
    cursor: pointer;
    will-change: transform, opacity;
  }

  .testimonials__card.is-active {
    border-color: rgba(255, 92, 53, 0.55);
    box-shadow:
      0 22px 48px rgba(0, 0, 0, 0.32),
      0 0 0 1px rgba(255, 92, 53, 0.18),
      0 18px 50px rgba(255, 92, 53, 0.12);
  }

  .testimonials__rating {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
  }

  .testimonials__quote {
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.65;
    letter-spacing: -0.02em;
    flex: 1;
  }

  .testimonials__person {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--line);
  }

  .testimonials__person img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    object-position: 50% 18%;
    border-radius: 50%;
  }

  .testimonials__name {
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .testimonials__role {
    margin-top: 0.15rem;
    color: var(--text-dim);
    font-size: 0.82rem;
  }

  @media (max-width: 900px) {
    .testimonials__proof {
      margin-top: -1.25rem;
      margin-bottom: 1.75rem;
    }

    .testimonials__viewport,
    .testimonials__track {
      min-height: 430px;
      height: 430px;
    }

    .testimonials__card {
      width: 86%;
      min-height: 400px;
    }
  }
</style>

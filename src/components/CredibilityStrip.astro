---
import { credibility } from '../data/portfolio';
---

<div class="credibility">
  <div class="container credibility__inner">
    {credibility.map((item) => (
      <div class="credibility__item">
        <span class="credibility__dot" aria-hidden="true"></span>
        <span>{item}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .credibility {
    border-block: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
  }

  .credibility__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg) var(--space-2xl);
    padding-block: var(--space-lg);
  }

  .credibility__item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .credibility__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gradient-accent);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .credibility__inner {
      flex-direction: column;
      align-items: center;
      gap: var(--space-md);
    }
  }
</style>

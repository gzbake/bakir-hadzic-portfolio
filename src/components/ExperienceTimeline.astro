---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/portfolio';
---

<section class="experience section-padding" id="experience">
  <div class="container">
    <SectionHeading
      number="02"
      label="EXPERIENCE"
      title="Professional Experience"
      description="Five years across agency, in-house, and independent work — from social media management to full brand builds."
    />

    <div class="timeline">
      {experience.map((item, index) => (
        <article class="timeline__item">
          <div class="timeline__marker" aria-hidden="true">
            <span class="timeline__dot"></span>
            {index < experience.length - 1 && <span class="timeline__line"></span>}
          </div>
          <div class="timeline__content">
            <div class="timeline__header">
              <div>
                <h3 class="timeline__company">{item.company}</h3>
                <p class="timeline__role">{item.role}</p>
              </div>
              <time class="timeline__dates mono-label">{item.dates}</time>
            </div>
            <ul class="timeline__highlights">
              {item.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline {
    max-width: 800px;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: var(--space-lg);
    padding-bottom: var(--space-2xl);
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  .timeline__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 6px;
  }

  .timeline__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--accent-cyan);
    background: var(--bg-primary);
    flex-shrink: 0;
  }

  .timeline__line {
    width: 1px;
    flex: 1;
    background: var(--border-subtle);
    margin-top: var(--space-sm);
  }

  .timeline__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .timeline__company {
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .timeline__role {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .timeline__dates {
    font-size: 0.6875rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .timeline__highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .timeline__highlights li {
    position: relative;
    padding-left: var(--space-md);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .timeline__highlights li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .timeline__header {
      flex-direction: column;
    }
  }
</style>

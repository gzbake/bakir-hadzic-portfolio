---
import SectionHeading from './SectionHeading.astro';
import { skills } from '../data/portfolio';
---

<section class="capabilities section-padding" id="capabilities">
  <div class="container">
    <SectionHeading
      number="03"
      label="CAPABILITIES"
      title="Capabilities"
      description="Six areas where strategy, creative and execution overlap — not six separate job titles."
    />

    <div class="capabilities__grid">
      {skills.map((group, index) => (
        <article class="capabilities__group">
          <span class="capabilities__index mono-label">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="capabilities__title">{group.title}</h3>
          <ul class="capabilities__list">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .capabilities__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xl) var(--space-xl);
  }

  .capabilities__group {
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
  }

  .capabilities__index {
    display: block;
    margin-bottom: var(--space-md);
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .capabilities__title {
    font-size: 1.125rem;
    margin-bottom: var(--space-md);
  }

  .capabilities__list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .capabilities__list li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .capabilities__list li::before {
    content: '· ';
    color: var(--accent-cyan);
  }

  @media (max-width: 968px) {
    .capabilities__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .capabilities__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

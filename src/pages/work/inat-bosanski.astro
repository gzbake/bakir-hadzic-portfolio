---
import Layout from '../../layouts/Layout.astro';
import { getProjectBySlug } from '../../data/portfolio';

const project = getProjectBySlug('inat-bosanski');

if (!project) {
  return Astro.redirect('/');
}
---

<Layout
  title={`${project.title} — Case Study | Bakir Hadžić`}
  description={project.description}
  canonical={`/work/${project.slug}`}
>
  <article class="case-study">
    <!-- Hero -->
    <header class="case-study__hero section-padding">
      <div class="container">
        <a href="/#work" class="case-study__back link-arrow">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" style="transform: rotate(180deg)">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to Work
        </a>
        <p class="mono-label case-study__category">{project.category}</p>
        <h1 class="case-study__title">{project.title}</h1>
        <p class="case-study__subtitle">{project.subtitle}</p>
      </div>
    </header>

    <hr class="gradient-divider" />

    <!-- Overview -->
    <section class="case-study__section section-padding">
      <div class="container case-study__split">
        <h2 class="case-study__section-title">Overview</h2>
        <p class="case-study__body">{project.overview}</p>
      </div>
    </section>

    <!-- My Role -->
    <section class="case-study__section">
      <div class="container case-study__split">
        <h2 class="case-study__section-title">My Role</h2>
        <div class="case-study__roles">
          {project.role.map((r) => (
            <span class="tag">{r}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- Challenge -->
    <section class="case-study__section section-padding">
      <div class="container case-study__split">
        <h2 class="case-study__section-title">Challenge</h2>
        <p class="case-study__body">{project.challenge}</p>
      </div>
    </section>

    <!-- Approach -->
    <section class="case-study__section section-padding">
      <div class="container">
        <h2 class="case-study__section-title case-study__section-title--full">Approach</h2>
        <div class="case-study__approach">
          {project.approach.map((step, index) => (
            <div class="case-study__approach-step">
              <span class="case-study__approach-num mono-label">{String(index + 1).padStart(2, '0')} {step.title}</span>
              <ul>
                {step.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Visual Showcase -->
    <section class="case-study__section section-padding">
      <div class="container">
        <h2 class="case-study__section-title case-study__section-title--full">Visual Showcase</h2>
        <div class="case-study__gallery">
          <div class="case-study__gallery-main">
            <div class="browser-frame">
              <div class="browser-frame__bar">
                <span class="browser-frame__dot"></span>
                <span class="browser-frame__dot"></span>
                <span class="browser-frame__dot"></span>
              </div>
              <div class="browser-frame__content">
                <img src={project.images[0]?.src} alt={project.images[0]?.alt} loading="lazy" width="1200" height="750" />
              </div>
            </div>
          </div>
          {project.images.length > 1 && (
            <div class="case-study__gallery-grid">
              {project.images.slice(1).map((img) => (
                <div class="browser-frame">
                  <div class="browser-frame__bar">
                    <span class="browser-frame__dot"></span>
                    <span class="browser-frame__dot"></span>
                    <span class="browser-frame__dot"></span>
                  </div>
                  <div class="browser-frame__content">
                    <img src={img.src} alt={img.alt} loading="lazy" width="600" height="400" />
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Tools -->
    <section class="case-study__section">
      <div class="container case-study__split">
        <h2 class="case-study__section-title">Technology / Tools</h2>
        <div class="case-study__tools">
          {project.tools.map((tool) => (
            <span class="tool-pill">{tool}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    {project.url && (
      <section class="case-study__cta section-padding">
        <div class="container case-study__cta-inner">
          <h2 class="case-study__cta-title">Visit the live website</h2>
          <a href={project.url} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
            {project.url.replace('https://', '')}
          </a>
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .case-study__hero {
    padding-bottom: var(--space-2xl);
  }

  .case-study__back {
    display: inline-flex;
    margin-bottom: var(--space-2xl);
    font-size: 0.875rem;
  }

  .case-study__category {
    margin-bottom: var(--space-md);
  }

  .case-study__title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-md);
  }

  .case-study__subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .case-study__split {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .case-study__section-title {
    font-size: 1rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .case-study__section-title--full {
    margin-bottom: var(--space-2xl);
  }

  .case-study__body {
    font-size: 1.0625rem;
    line-height: 1.75;
    max-width: 640px;
  }

  .case-study__roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .case-study__approach {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-lg);
  }

  .case-study__approach-step {
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
  }

  .case-study__approach-num {
    display: block;
    margin-bottom: var(--space-md);
    font-size: 0.6875rem;
  }

  .case-study__approach-step ul {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .case-study__approach-step li {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .case-study__approach-step li::before {
    content: '· ';
    color: var(--accent-cyan);
  }

  .case-study__gallery-main {
    margin-bottom: var(--space-xl);
  }

  .case-study__gallery-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  .case-study__tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .case-study__cta {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
  }

  .case-study__cta-inner {
    text-align: center;
  }

  .case-study__cta-title {
    margin-bottom: var(--space-lg);
  }

  @media (max-width: 968px) {
    .case-study__split {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .case-study__approach {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .case-study__approach {
      grid-template-columns: 1fr;
    }

    .case-study__gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

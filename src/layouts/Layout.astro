---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const { title, description, image, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEO title={title} description={description} image={image} canonical={canonical} />
    <noscript>
      <style>.reveal { opacity: 1 !important; }</style>
    </noscript>
  </head>
  <body>
    <div id="ripple-wrap">
      <canvas id="ripple-canvas" aria-hidden="true"></canvas>
    </div>
    <div class="bg-fallback" id="bg-fallback" hidden></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/init';
    </script>
  </body>
</html>
